+	case 111: /* GD model movd $tlsvar, reg -> TLSDESC sequence: adrp x0; ldr x1,[x0]; add x0,x0; blr x1 */
+		// TLSDESC ABI: result (TLS offset) is always in X0.
+		// Clobbers X0, X1, and LR (X30).
